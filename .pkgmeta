package-as: LibGoThere-1.0

# LibStub is fetched at package time and never committed, pinned to a commit of the Ace3 GitHub
# mirror (its tags stop in 2010). tests/libs.lua reads this block and fetches the same commit into
# Libs/ for the tests.
externals:
  Libs/LibStub:
    url: https://github.com/WoWUIDev/Ace3.git
    commit: 40f4cc1356ae7fcc0cf71fc0a19dc7d50d6ae6c2
    path: LibStub

ignore:
  - annotations
  - coverage
  - tests
  - libgothere-dev-1.rockspec
  - stylua.toml
